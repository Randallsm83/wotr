# WotR Companion — Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# ── Required for AI Advisor ────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional overrides ─────────────────────────────────────────────────────────
# Server port (default: 3000)
# PORT=3000

# WotR save directory (auto-detected from %APPDATA% if not set)
# WOTR_SAVES_DIR=C:\Users\YourName\AppData\LocalLow\Owlcat Games\Pathfinder Wrath Of The Righteous\Saved Games

# WotR game directory (auto-detected from Steam if not set)
# WOTR_GAME_DIR=A:\SteamGames\steamapps\common\Pathfinder Second Adventure
