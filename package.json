{
  "name": "wotr",
  "version": "0.1.0",
  "type": "module",
  "description": "Pathfinder: Wrath of the Righteous companion app",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "dev:client": "vite --config vite.config.ts",
    "dev:all": "bun run scripts/dev-all.ts",
    "index": "bun run scripts/build-index.ts",
    "build:client": "vite build --config vite.config.ts",
    "start": "bun run src/server/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "fflate": "^0.8.2",
    "hono": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
